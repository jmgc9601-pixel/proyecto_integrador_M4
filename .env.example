# ==============================================================================
# Variables de entorno para MateCode (Firebase Authentication y Cloud Firestore)
# ==============================================================================
# Copia este archivo como .env y reemplaza los valores con las credenciales
# de tu proyecto en la consola de Firebase (Project Settings > General > Your apps)

VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_project_id
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id
VITE_FIREBASE_APP_ID=tu_app_id

# ==============================================================================
# Variables de entorno para AWS SES — Función Serverless (Vercel)
# ==============================================================================
# IMPORTANTE: Estas variables NO deben llevar el prefijo VITE_ porque son
# exclusivas del servidor y nunca deben quedar expuestas en el bundle del frontend.
# Configúralas en Vercel: Project Settings > Environment Variables.
# NO las añadas al archivo .env de desarrollo local.

AWS_ACCESS_KEY_ID=tu_aws_access_key_id
AWS_SECRET_ACCESS_KEY=tu_aws_secret_access_key
AWS_REGION=us-east-1
SES_FROM_EMAIL=noreply@tudominio.com


# ==============================================================================
# Variables privadas para Firebase Admin SDK — Solo servidor
# ==============================================================================
FIREBASE_PROJECT_ID=tu_project_id
FIREBASE_CLIENT_EMAIL=tu_service_account_email
FIREBASE_PRIVATE_KEY="tu_service_account_private_key"
